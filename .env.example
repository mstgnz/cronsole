# Cronsole configuration.
#
# Copy to .env and fill in. Every setting is read once, at start up, by
# internal/config; nothing else in the code calls os.Getenv.
#
# A local run can point at its own file instead of touching this one:
#   ENV_FILE=.env.local make live

# --- application ------------------------------------------------------------

APP_NAME=cronsole
# production turns on the fail-fast checks below. Anything else is development.
APP_ENV=development
APP_PORT=3333
# Public address of this service. Used in alert mails and in the sync example
# on the projects screen. Setting an https:// address also marks the session
# cookie Secure.
APP_URL=http://localhost:3333

# Which header carries the real client address, if this service sits behind a
# proxy. EMPTY BY DEFAULT, and that default is load bearing: a forwarding header
# is an ordinary request header, so trusting one when there is no proxy in front
# lets any caller pick their own rate-limit bucket, and the login form becomes
# an unlimited password oracle.
#
# Set it only to the header your own proxy sets, and only when there is one:
#   nginx, HAProxy, a load balancer  ->  X-Forwarded-For  (with the hop count)
#   Cloudflare                       ->  CF-Connecting-IP
#   Vercel                           ->  X-Vercel-Forwarded-For
# Anything else is refused at boot rather than quietly ignored.
TRUSTED_PROXY_HEADER=
# How many proxies append to X-Forwarded-For, so the client's own entry can be
# counted from the right. One for a single nginx in front. Ignored for the
# single-value headers, which a proxy overwrites rather than appends to.
TRUSTED_PROXY_HOPS=1

# --- database ---------------------------------------------------------------

DB_HOST=localhost
DB_PORT=5432
DB_NAME=cron
DB_USER=cron_writer
DB_PASS=
# require by default. disable is refused in production unless the host is
# loopback, because it sends the password in clear text.
DB_SSLMODE=require
# Cron expressions are read against this zone.
DB_ZONE=Europe/Istanbul

# --- signing ----------------------------------------------------------------

# At least 32 characters. Generate with: openssl rand -hex 32
# A short secret makes every session token forgeable, so boot is refused.
JWT_SECRET=

# --- first run --------------------------------------------------------------
#
# There is nothing to set. While the users table is empty the service serves
# one screen, /setup, which creates the first administrator and then closes for
# good. That screen is open to whoever reaches the address first, so set the
# account up before the deployment is public.
#
# No credentials in the environment on purpose: an administrator password in a
# .env file, a shell history and a container spec is one that stays valid long
# after everyone has forgotten it is there.

# --- scheduler --------------------------------------------------------------

# false serves the interface without running anything. Use it for a second
# instance, or a developer copy pointed at production data.
SCHEDULER_ENABLED=true
# true computes each tick and writes nothing: no queued rows, no execution, no
# heartbeat. For checking a configuration before it goes live.
SCHEDULER_DRY_RUN=false
# Runs in flight across the whole service.
SCHEDULER_MAX_CONCURRENT=20
# Backlog depth. Must be at least SCHEDULER_MAX_CONCURRENT. A full queue is
# logged and the runs stay pending, so nothing is lost.
SCHEDULER_QUEUE_SIZE=512
# How far back a restarted dispatcher replays missed minutes, for jobs that
# have run_missed set. A dispatcher down for a week must not queue a week of
# work at once.
SCHEDULER_MISS_SCAN_MIN=60

# Serves /metrics for Prometheus. The endpoint is unauthenticated, as a scrape
# target normally is, and it discloses project names, job names and run counts.
# Fine inside a cluster; turn it off, or block it at the ingress, if this
# service is reachable from outside.
METRICS_ENABLED=true

# --- watchdog ---------------------------------------------------------------

WATCHDOG_EVERY_MIN=5
# A heartbeat older than this means the dispatcher is down.
WATCHDOG_HEARTBEAT_LIMIT_MIN=5
# Tolerated gap between the application and database clocks.
WATCHDOG_DRIFT_LIMIT_SEC=30
# Failures per hour, per job, before an alert.
WATCHDOG_FAILURE_THRESHOLD=5
# Comma separated. REQUIRED in production: the watchdog is the only thing that
# notices the scheduler itself dying, and with no recipient it notices in
# silence.
WATCHDOG_ALERT_TO=
# Shortest gap between two mails about the same set of warnings.
WATCHDOG_ALERT_REPEAT_MIN=60

# --- retention --------------------------------------------------------------

# Both tables grow with every execution and nothing else deletes from them.
# 0 disables pruning.
RUN_RETENTION_DAYS=90
LOG_RETENTION_DAYS=90

# --- outbound ---------------------------------------------------------------

OUTBOUND_USER_AGENT=cronsole/2 (+scheduled trigger)
# How much of a response body is read into memory, in KB.
OUTBOUND_MAX_BODY_KB=64
# true allows job targets on loopback and private ranges, which is the normal
# case for a scheduler calling internal services. Set false for a deployment
# whose jobs are all public; that turns the SSRF guard back on.
OUTBOUND_ALLOW_PRIVATE=true

# --- containers -------------------------------------------------------------

# Empty by default, and then the container panel does not exist.
#
# This is the address of a READ-ONLY Docker API proxy, never the socket. Anything
# that can reach /var/run/docker.sock can start a privileged container and own
# the machine, and mounting it :ro does not change that: the flag makes the
# socket file read-only, not the API behind it. A proxy publishing the container
# list and nothing else costs this process no privilege at all.
# See docs/operations.md#the-container-panel for the four lines that set one up.
DOCKER_API=
# Optional. Passed to Docker's own filter, so only containers carrying this
# label are listed. Empty lists every container on the host.
DOCKER_LABEL=

# --- mail -------------------------------------------------------------------

# Required in production. Without it, job notifications and watchdog alerts are
# not sent, and the absence is logged once rather than per message.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Cronsole
