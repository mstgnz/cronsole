{{/*
  Says what a run is not showing, given the field allow-list on runs.read.
  Without it a masked field is indistinguishable from an empty one, and a
  reader would take "no output" to mean the job answered with nothing.

  Argument: an authz.RunView.
*/}}
{{ define "run-restricted" }}
{{ if not (and .Output .Error .RequestURL) }}
<div class="alert alert-secondary small py-2 mb-3">
  <i class="bi bi-eye-slash me-1"></i>
  {{ t "Your access to this project hides part of this run:" }}
  {{ if not .RequestURL }}{{ t "the address called" }}{{ end }}{{ if and (not .RequestURL) (not .Error) }},{{ end }}
  {{ if not .Error }}{{ t "the error" }}{{ end }}{{ if and (not .Error) (not .Output) }},{{ end }}
  {{ if not .Output }}{{ t "the response body" }}{{ end }}.
</div>
{{ end }}
{{ end }}
