{{ define "content" }}
<div class="row justify-content-center">
  <div class="col-12 col-md-6 text-center py-5">
    <i class="bi bi-exclamation-octagon fs-1 text-danger d-block mb-3"></i>
    <h1 class="h5 mb-2">{{ t "Something went wrong" }}</h1>
    <p class="text-body-secondary small">
      {{ t "The detail is in the service log, under Settings. Nothing was changed by this request." }}
    </p>
    <a class="btn btn-outline-secondary btn-sm" href="/">{{ t "Back to the dashboard" }}</a>
  </div>
</div>
{{ end }}
